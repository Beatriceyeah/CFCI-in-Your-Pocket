# Copy to .env and fill in. Never commit .env.

# Backend
# Development database (Docker Compose overrides the host to `db` inside the backend container)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# For running pytest locally, point at the test database instead:
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Frontend (read by Vite; put in frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000
